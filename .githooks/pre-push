#!/bin/sh

set -eu

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "ERROR: KIN pre-push hook could not locate the repository." >&2
  exit 2
}
script_directory="$repo_root/scripts"

gate="$script_directory/kin-privacy-gate.sh"
if [ ! -x "$gate" ]; then
  echo "ERROR: KIN pre-push privacy gate is missing or not executable." >&2
  exit 2
fi

# Git supplies one line per update on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# Scan exactly the objects that are about to become reachable remotely. This
# avoids the old staged-only hole while keeping unrelated local history out of
# the push decision. A deleted remote ref has no new objects to scan.
ranges_file="$(mktemp "${TMPDIR:-/tmp}/kin-pre-push-ranges.XXXXXX")"
cleanup() {
  rm -f "$ranges_file"
}
trap cleanup EXIT HUP INT TERM

updates="$(cat)"
if [ -z "$updates" ]; then
  echo "ERROR: KIN pre-push received no ref updates; refusing an ambiguous push." >&2
  exit 2
fi

while IFS=' ' read -r local_ref local_sha remote_ref remote_sha remainder; do
  [ -n "${local_ref:-}" ] || continue
  if [ -n "${remainder:-}" ] || [ -z "${local_sha:-}" ] || [ -z "${remote_sha:-}" ]; then
    echo "ERROR: KIN pre-push received a malformed ref update." >&2
    exit 2
  fi
  if ! printf '%s\n' "$local_sha" | grep -Eq '^[0-9a-fA-F]{40,64}$'; then
    echo "ERROR: KIN pre-push received an invalid local object id." >&2
    exit 2
  fi
  if printf '%s\n' "$remote_sha" | grep -Eq '^0+$'; then
    printf '%s\n' "$local_sha" >> "$ranges_file"
  else
    if ! printf '%s\n' "$remote_sha" | grep -Eq '^[0-9a-fA-F]{40,64}$'; then
      echo "ERROR: KIN pre-push received an invalid remote object id." >&2
      exit 2
    fi
    printf '%s..%s\n' "$remote_sha" "$local_sha" >> "$ranges_file"
  fi
done <<EOF
$updates
EOF

if [ ! -s "$ranges_file" ]; then
  echo "KIN pre-push: ref deletion only; no new objects require a privacy scan." >&2
else
  while IFS= read -r ref_range; do
    echo "KIN pre-push: scanning push ref range." >&2
    "$gate" --ref-range "$ref_range" --source-only --require-ocr
  done < "$ranges_file"
fi

echo "KIN pre-push: running unsigned test preflight." >&2
"$script_directory/kin-test-preflight.sh"

echo "KIN pre-push: push-range privacy and tests passed." >&2
